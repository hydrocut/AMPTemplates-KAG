Meta.ConfigRoot=kag.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=Le serveur est un binaire 32 bits : en conteneur, les libs i386 sont installees par ExtraContainerPackages ; sur l'hote, elles doivent y etre deja.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["libc6:i386","libstdc++6:i386","libgcc-s1:i386"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
